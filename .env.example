HOST=127.0.0.1
PORT=6981

DATABASE_PATH=./data/slab-email.db

SLAB_EMAIL_ADMIN_KEY=
SLAB_EMAIL_MASTER_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:6981/api/oauth/google/callback

MAX_SENDS_PER_ACCOUNT_PER_HOUR=60
INBOUND_POLL_INTERVAL_SECONDS=30
MCP_ALLOWED_ORIGINS=127.0.0.1:6981,localhost:6981
MCP_ALLOWED_ORIGINS_HOSTS=127.0.0.1,localhost,[::1]
PUBLIC_ADMIN_ALLOWED_ORIGINS=127.0.0.1:6981,localhost:6981
NODE_ENV_ALLOW_INSECURE_LOCAL=false
SMTP_MESSAGE_ID_DOMAIN=
GMAIL_SCOPE_READ=https://www.googleapis.com/auth/gmail.readonly
GMAIL_SCOPE_COMPOSE=https://www.googleapis.com/auth/gmail.compose
GMAIL_SCOPE_SEND=https://www.googleapis.com/auth/gmail.send
GMAIL_TOKEN_REFRESH_WINDOW_SECONDS=300

LOG_LEVEL=info
